# Ghost Paths configuration. Copy to .env (git-ignored). Every live dependency sits behind a flag
# so the deterministic offline/testnet path works with no secrets. Never commit real keys.

# NEAR network. "mainnet" is only used by `make demo-live`.
GHOST_NETWORK=testnet

# Registry/signer contract. Set DEPLOY=1 to deploy a fresh sub-account from the committed wasm.
GHOST_CONTRACT=v1.ghost-paths.testnet
# DEPLOY=1

# MPC signer contract. Derived from the network when unset (v1.signer-prod.testnet / v1.signer).
# GHOST_SIGNER=v1.signer-prod.testnet

# Chains that `make demo` exercises (comma separated). Add btc:regtest only if it is implemented.
GHOST_CHAINS=evm:31337,sol:local

# Relayer for announcements and sweeps. Unset: submit from the user's own account (with a warning).
GHOST_RELAYER_URL=http://127.0.0.1:8787

# "contract" (Mode B, the product) or "account" (Mode A fallback).
GHOST_MODE=contract

# 1 = no network at all; fixtures replace NEAR, MPC and chains (`make demo-replay`, CI).
# GHOST_REPLAY=1

# 1 = tests also hit the testnet MPC (one ECDSA and one EdDSA sign, about 30 s).
# LIVE=1

# Optional 1Click API key. Dry quotes work without it.
# ONECLICK_API_KEY=

# Public-testnet funders for `make demo-testnet`. On the dev host demo/fund.ts uses lechu-wallet instead.
# FUNDER_EVM_PK=
# FUNDER_SOL_KEY=
# BTC_FUNDER=

# Hard gate for anything that spends mainnet funds (`make demo-live`).
# MAINNET_APPROVED=1
