    "functions": [
      {
        "name": "announce",
        "doc": " Append an announcement and return its index. Payable: attach storage (127 bytes =\n 0.00127 NEAR without a memo, +0.00001 NEAR per memo char; 0.003 NEAR covers a 160-char\n memo). The excess is refunded.\n `chain`: chain tag, `[a-z0-9:-]`, 1..=32 chars. `eph`: 32-byte X25519 ephemeral key, hex.\n `tag`: view tag. `ct`: optional memo ciphertext, printable ASCII, 1..=1024 chars.",
        "kind": "call",
        "modifiers": [
          "payable"
        ],
        "params": {
          "serialization_type": "json",
          "args": [
            {
              "name": "chain",
              "type_schema": {
                "type": "string"
              }
            },
            {
              "name": "eph",
              "type_schema": {
                "type": "string"
              }
            },
            {
              "name": "tag",
              "type_schema": {
                "type": "integer",
                "format": "uint8",
                "minimum": 0.0
              }
            },
            {
              "name": "ct",
              "type_schema": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          ]
        },
        "result": {
          "serialization_type": "json",
          "type_schema": {
            "type": "integer",
            "format": "uint64",
            "minimum": 0.0
          }
        }
      },
